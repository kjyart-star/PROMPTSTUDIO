{
  "name": "suno-prompt",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "dev:stable": "node scripts/dev-stable.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "npm run build && node scripts/serve-dist.mjs --host 127.0.0.1 --port 4173",
